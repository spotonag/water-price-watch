{
  "name": "water-price-watch",
  "version": "1.0.0",
  "description": "Watch Ruralco Water sell-order prices for Vic Goulburn Zone 1A and send Twilio SMS alerts when prices change.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "check": "node src/check.js",
    "dev": "node --watch src/server.js",
    "postinstall:browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "@playwright/test": "^1.61.0",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.13.1",
    "twilio": "^5.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
